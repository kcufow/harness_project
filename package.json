{
  "name": "harness-plugin-pack",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Harness 插件实现：dangerous-op-precheck（危险操作预检清单）与 skill-usage-audit（技能使用审计）",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "node scripts/smoke.mjs",
    "smoke:installed": "node --import ./scripts/dsh-register.mjs ./scripts/smoke-installed.mjs",
    "check": "npm run build && npm run test && npm run smoke",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
